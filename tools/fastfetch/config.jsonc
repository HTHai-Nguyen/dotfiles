{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/fedora_tux.png",
    // "color": {
    //   "1": "#7aa2f7",
    //   "2": "#bb9af7",
    //   "3": "#7dcfff"
    // },
    "width": 30,
    "height": 15,
    "padding": {
      "right": 4,
      "top": 1
    }
  },
  "display": {
    "separator": " 󰁔 ",
    "color": {
      "keys": "#7aa2f7",
      "title": "#bb9af7"
    },
    "key": {
      "width": 13
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "outputColor": "#bb9af7"
    },
    {
      "type": "separator"
    },
    {
      "type": "os",
      "key": "Distro",
      "keyColor": "#7dcfff"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "#7aa2f7"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "display",
      "key": "Display"
    },
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "break"
    },
    {
      "type": "host",
      "key": "Laptop",
      "keyColor": "#bb9af7"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "#e0af68"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "#e0af68"
    },
    {
      "type": "memory",
      "key": "RAM",
      "keyColor": "#9ece6a"
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "#9ece6a"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "#7dcfff"
    }
  ]
}
